{
  "name": "@chanx-js/client",
  "version": "0.1.0",
  "description": "Type-safe WebSocket client for chanx AsyncAPI schemas, with topic multiplexing.",
  "license": "MIT",
  "author": "Huy Nguyen",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --clean",
    "typecheck": "tsc -p tsconfig.json"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "websocket",
    "asyncapi",
    "@chanx-js/client",
    "typescript"
  ]
}
