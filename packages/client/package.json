{
  "name": "@chanx-js/client",
  "version": "0.1.0",
  "description": "Type-safe WebSocket client for chanx AsyncAPI schemas, with topic multiplexing.",
  "license": "MIT",
  "author": "Huy Nguyen",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    },
    "./react": {
      "types": "./dist/react/index.d.mts",
      "default": "./dist/react/index.mjs"
    }
  },
  "scripts": {
    "build": "tsdown src/index.ts src/react/index.ts --format esm --dts --clean --external react",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "react": "^19.1.0"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "websocket",
    "asyncapi",
    "@chanx-js/client",
    "typescript",
    "react"
  ]
}
